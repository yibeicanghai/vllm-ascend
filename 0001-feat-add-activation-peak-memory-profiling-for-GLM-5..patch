index 000000000..54ddf5a02
--- /dev/null
+++ b/vllm_ascend/activation_memory.py
@@ -0,0 +1,356 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+"""Scoped activation-memory peak diagnostics for Ascend profile runs.
+
+Adapted from vllm-ascend v0.23 for v0.30 DSA-CP + SP-MoE execution path.
+Target: GLM-5.2 (glm_moe_dsa) 1M prefill peak memory profiling.
+
+Usage:
+  Set additional_config={"activation_peak_debug": true, "activation_peak_debug_rank": 0}
+  AND enforce_eager=true (graph capture is incompatible with NPU sync).
+
+The profiler uses nested context managers via ContextVar, so any code in the
+forward path can record a scoped peak without passing the profiler around:
+
+    with record_activation_peak("target_attn", "sfa_mla", layer_idx=idx):
+        # ... sparse MLA attention ...
+
+Each scope records:
+  - baseline_bytes: torch.npu.memory_allocated() before the scope
+  - peak_bytes: max(torch.npu.max_memory_allocated()) during the scope
+  - allocated_after_bytes: torch.npu.memory_allocated() after the scope
+  - peak_growth_bytes: peak - baseline (transient peak)
+  - retained_bytes: after - baseline (retained by this scope)
+
+Nested scopes propagate their peak to parent scopes.
+"""
+
+from __future__ import annotations
+
+import time
+from collections.abc import Iterator
+from contextlib import contextmanager
+from contextvars import ContextVar
+from dataclasses import dataclass, field
+
+import torch
+from vllm.logger import logger
+
+_MIB = 1024**2
+_GIB = 1024**3
+
+
+@dataclass(frozen=True)
+class ActivationPeakRecord:
+    category: str
+    label: str
+    layer_idx: int | None
+    num_tokens: int | None
+    baseline_bytes: int
+    peak_bytes: int
+    allocated_after_bytes: int
+    peak_growth_bytes: int
+    retained_bytes: int
+    elapsed_ms: float
+
+
+@dataclass(frozen=True)
+class ActivationBufferRecord:
+    category: str
+    label: str
+    size_bytes: int
+
+
+@dataclass
+class _ActiveScope:
+    category: str
+    label: str
+    layer_idx: int | None
+    num_tokens: int | None
+    baseline_bytes: int
+    started_at: float
+    peak_bytes: int = 0
+
+
+@dataclass
+class ActivationPeakProfiler:
+    """Collect nested peak measurements without losing the global profile peak."""
+
+    rank: int
+    records: list[ActivationPeakRecord] = field(default_factory=list)
+    buffers: list[ActivationBufferRecord] = field(default_factory=list)
+    overall_peak_bytes: int = 0
+    _scopes: list[_ActiveScope] = field(default_factory=list)
+
+    def _synchronize(self) -> None:
+        torch.npu.synchronize()
+
+    def _checkpoint(self) -> int:
+        self._synchronize()
+        peak_bytes = int(torch.npu.max_memory_allocated())
+        self.overall_peak_bytes = max(self.overall_peak_bytes, peak_bytes)
+        for scope in self._scopes:
+            scope.peak_bytes = max(scope.peak_bytes, peak_bytes)
+        return peak_bytes
+
+    @contextmanager
+    def record(
+        self,
+        category: str,
+        label: str,
+        *,
+        layer_idx: int | None = None,
+        num_tokens: int | None = None,
+    ) -> Iterator[None]:
+        # Preserve parent work performed before resetting the peak for this
+        # child. Nested scopes propagate their peak back to every parent.
+        self._checkpoint()
+        baseline_bytes = int(torch.npu.memory_allocated())
+        torch.npu.reset_peak_memory_stats()
+        scope = _ActiveScope(
+            category=category,
+            label=label,
+            layer_idx=layer_idx,
+            num_tokens=num_tokens,
+            baseline_bytes=baseline_bytes,
+            started_at=time.perf_counter(),
+            peak_bytes=baseline_bytes,
+        )
+        self._scopes.append(scope)
+        try:
+            yield
+        finally:
+            self._checkpoint()
+            allocated_after_bytes = int(torch.npu.memory_allocated())
+            self._scopes.pop()
+            peak_bytes = max(scope.peak_bytes, allocated_after_bytes)
+            if self._scopes:
+                self._scopes[-1].peak_bytes = max(self._scopes[-1].peak_bytes, peak_bytes)
+            record = ActivationPeakRecord(
+                category=category,
+                label=label,
+                layer_idx=layer_idx,
+                num_tokens=num_tokens,
+                baseline_bytes=baseline_bytes,
+                peak_bytes=peak_bytes,
+                allocated_after_bytes=allocated_after_bytes,
+                peak_growth_bytes=max(0, peak_bytes - baseline_bytes),
+                retained_bytes=allocated_after_bytes - baseline_bytes,
+                elapsed_ms=(time.perf_counter() - scope.started_at) * 1000,
+            )
+            self.records.append(record)
+
+    def record_buffer(self, category: str, label: str, size_bytes: int) -> None:
+        record = ActivationBufferRecord(
+            category=category,
+            label=label,
+            size_bytes=size_bytes,
+        )
+        self.buffers.append(record)
+        logger.warning(
+            "[ACTIVATION_PEAK][BUFFER] rank=%s category=%s label=%s persistent=%.3f MiB (%.3f GiB)",
+            self.rank,
+            category.upper(),
+            label,
+            size_bytes / _MIB,
+            size_bytes / _GIB,
+        )
+
+    def log_summary(self) -> None:
+        if not self.records and not self.buffers:
+            logger.warning("[ACTIVATION_PEAK][SUMMARY] rank=%s no measured stages", self.rank)
+            return
+
+        # Category winners: the record with the HIGHEST ABSOLUTE PEAK per
+        # category (not growth — the goal is to find which stage sets the
+        # memory ceiling).
+        category_winners: dict[str, ActivationPeakRecord] = {}
+        for record in self.records:
+            previous = category_winners.get(record.category)
+            if previous is None or record.peak_bytes > previous.peak_bytes:
+                category_winners[record.category] = record
+
+        buffer_winners: dict[str, ActivationBufferRecord] = {}
+        for record in self.buffers:
+            previous = buffer_winners.get(record.category)
+            if previous is None or record.size_bytes > previous.size_bytes:
+                buffer_winners[record.category] = record
+
+        # Top-10 records by ABSOLUTE PEAK (the bottleneck stages to optimize).
+        top_peak = sorted(self.records, key=lambda r: r.peak_bytes, reverse=True)[:10]
+
+        # Absolute peak across all records.
+        absolute_peak_record = max(self.records, key=lambda r: r.peak_bytes)
+
+        sep = "=" * 80
+        logger.warning("[ACTIVATION_PEAK] %s", sep)
+        logger.warning("[ACTIVATION_PEAK] rank=%s  ACTIVATION MEMORY PEAK REPORT", self.rank)
+        logger.warning("[ACTIVATION_PEAK] %s", sep)
+
+        # Section A: Absolute peak
+        logger.warning(
+            "[ACTIVATION_PEAK][ABSOLUTE_PEAK] rank=%s category=%s label=%s "
+            "layer=%s tokens=%s baseline=%.3f GiB peak=%.3f GiB "
+            "growth=%.3f MiB retained=%+.3f MiB",
+            self.rank,
+            absolute_peak_record.category.upper(),
+            absolute_peak_record.label,
+            "-" if absolute_peak_record.layer_idx is None else absolute_peak_record.layer_idx,
+            "-" if absolute_peak_record.num_tokens is None else absolute_peak_record.num_tokens,
+            absolute_peak_record.baseline_bytes / _GIB,
+            absolute_peak_record.peak_bytes / _GIB,
+            absolute_peak_record.peak_growth_bytes / _MIB,
+            absolute_peak_record.retained_bytes / _MIB,
+        )
+
+        # Section B: Per-category summary (sorted by absolute peak)
+        for category, record in sorted(
+            category_winners.items(),
+            key=lambda item: item[1].peak_bytes,
+            reverse=True,
+        ):
+            logger.warning(
+                "[ACTIVATION_PEAK][SUMMARY] rank=%s category=%s abs_peak=%.3f GiB "
+                "growth=%.3f MiB label=%s layer=%s tokens=%s",
+                self.rank,
+                category.upper(),
+                record.peak_bytes / _GIB,
+                record.peak_growth_bytes / _MIB,
+                record.label,
+                "-" if record.layer_idx is None else record.layer_idx,
+                "-" if record.num_tokens is None else record.num_tokens,
+            )
+
+        for category, record in sorted(buffer_winners.items()):
+            logger.warning(
+                "[ACTIVATION_PEAK][SUMMARY] rank=%s category=%s persistent=%.3f MiB (%.3f GiB) label=%s",
+                self.rank,
+                category.upper(),
+                record.size_bytes / _MIB,
+                record.size_bytes / _GIB,
+                record.label,
+            )
+
+        # Section C: Top-10 by absolute peak
+        logger.warning("[ACTIVATION_PEAK][TOP10_PEAK] rank=%s (optimize these to lower the ceiling)", self.rank)
+        for i, r in enumerate(top_peak):
+            logger.warning(
+                "[ACTIVATION_PEAK]   #%2d  %-22s %-34s layer=%-4s  "
+                "abs_peak=%.3f GiB  growth=%.3f MiB",
+                i + 1,
+                r.category.upper(),
+                r.label,
+                "-" if r.layer_idx is None else r.layer_idx,
+                r.peak_bytes / _GIB,
+                r.peak_growth_bytes / _MIB,
+            )
+
+        # Section D: Verdict
+        top_level = [
+            record
+            for category in ("target_model",)
+            if (record := category_winners.get(category)) is not None
+        ]
+        components = [
+            record for category, record in category_winners.items() if category not in {"target_model"}
+        ]
+        dominant_top = max(top_level, key=lambda item: item.peak_bytes, default=None)
+        dominant_activation = max(components, key=lambda item: item.peak_bytes, default=None)
+        dominant_buffer = max(buffer_winners.values(), key=lambda item: item.size_bytes, default=None)
+        if dominant_buffer is not None and (
+            dominant_activation is None or dominant_buffer.size_bytes > dominant_activation.peak_bytes
+        ):
+            dominant_component_category = dominant_buffer.category.upper()
+            dominant_component_kind = "PERSISTENT_BUFFER"
+            dominant_component_bytes = dominant_buffer.size_bytes
+        elif dominant_activation is not None:
+            dominant_component_category = dominant_activation.category.upper()
+            dominant_component_kind = "ABSOLUTE_PEAK"
+            dominant_component_bytes = dominant_activation.peak_bytes
+        else:
+            dominant_component_category = "UNKNOWN"
+            dominant_component_kind = "UNKNOWN"
+            dominant_component_bytes = 0
+        logger.warning("[ACTIVATION_PEAK] %s", sep)
+        logger.warning(
+            "[ACTIVATION_PEAK][VERDICT] rank=%s dominant_top_level=%s "
+            "top_level_peak=%s dominant_component=%s component_kind=%s "
+            "component_bytes=%.3f MiB profile_absolute_peak=%.3f GiB "
+            "at_category=%s at_label=%s at_layer=%s",
+            self.rank,
+            dominant_top.category.upper() if dominant_top else "UNKNOWN",
+            f"{dominant_top.peak_bytes / _GIB:.3f} GiB" if dominant_top else "unknown",
+            dominant_component_category,
+            dominant_component_kind,
+            dominant_component_bytes / _MIB,
+            self.overall_peak_bytes / _GIB,
+            absolute_peak_record.category.upper(),
+            absolute_peak_record.label,
+            "-" if absolute_peak_record.layer_idx is None else absolute_peak_record.layer_idx,
+        )
+        logger.warning("[ACTIVATION_PEAK] %s", sep)
+
+
+_ACTIVE_PROFILER: ContextVar[ActivationPeakProfiler | None] = ContextVar(
+    "ascend_activation_peak_profiler",
+    default=None,
+)
+
+
+def is_activation_peak_profiling() -> bool:
+    return _ACTIVE_PROFILER.get() is not None
+
+
+@contextmanager
+def activation_peak_profile_session(
+    *,
+    enabled: bool,
+    rank: int,
+) -> Iterator[ActivationPeakProfiler | None]:
+    if not enabled:
+        yield None
+        return
+
+    profiler = ActivationPeakProfiler(rank=rank)
+    profiler._synchronize()
+    profiler.overall_peak_bytes = int(torch.npu.max_memory_allocated())
+    torch.npu.reset_peak_memory_stats()
+    token = _ACTIVE_PROFILER.set(profiler)
+    logger.warning(
+        "[ACTIVATION_PEAK] rank=%s profiling enabled; NPU synchronization is active and intended only for debugging.",
+        rank,
+    )
+    try:
+        yield profiler
+    finally:
+        profiler._checkpoint()
+        _ACTIVE_PROFILER.reset(token)
+        profiler.log_summary()
+
+
+@contextmanager
+def record_activation_peak(
+    category: str,
+    label: str,
+    *,
+    layer_idx: int | None = None,
+    num_tokens: int | None = None,
+) -> Iterator[None]:
+    profiler = _ACTIVE_PROFILER.get()
+    if profiler is None:
+        yield
+        return
+    with profiler.record(
+        category,
+        label,
+        layer_idx=layer_idx,
+        num_tokens=num_tokens,
+    ):
+        yield
+
+
+def record_activation_buffer(category: str, label: str, size_bytes: int) -> None:
+    profiler = _ACTIVE_PROFILER.get()
+    if profiler is not None:
+        profiler.record_buffer(category, label, size_bytes)
