+## 五、插桩代码示例
+
+### 5.1 顶层控制（文件 1）
+
+```python
+# worker/model_runner_v1.py — NPUModelRunner.forward 方法中
+def forward(self, ...):
+    torch.npu.reset_peak_memory()          # 重置峰值统计
+    mem_start = torch.npu.memory_allocated()
+    
+    # ... 原有 forward 逻辑 ...
+    
+    mem_end = torch.npu.memory_allocated()
+    mem_peak = torch.npu.max_memory_allocated()
+    logger.info(
+        f"[MEM] forward: start={mem_start//1024//1024}MB "
+        f"end={mem_end//1024//1024}MB peak={mem_peak//1024//1024}MB"
+    )
+```
+
+### 5.2 层循环（文件 2）
+
+```python
+# patch/worker/patch_deepseek_v2.py — _patched_forward 中 L426-432
+for idx, layer in enumerate(
+    islice(self.layers, self.start_layer, self.end_layer),
+    start=self.start_layer,
+):
+    mem_before = torch.npu.memory_allocated()
+    torch.npu.reset_peak_memory()           # 每层重置峰值
+    
+    hidden_states, residual = layer(positions, hidden_states, residual, llama_4_scaling)
+    
+    mem_after = torch.npu.memory_allocated()
+    mem_peak = torch.npu.max_memory_allocated()
+    logger.info(
+        f"[MEM] Layer {idx}: before={mem_before//1024//1024}MB "
+        f"after={mem_after//1024//1024}MB peak={mem_peak//1024//1024}MB "
+        f"delta={(mem_peak-mem_before)//1024//1024}MB"
+    )
+    _capture_aux_hidden_state(self, aux_hidden_states, idx + 1, hidden_states, residual, positions)
+```
+
+### 5.3 Decoder Layer 子层（文件 3）
+
+```python
+# models/deepseek_mtp.py — AscendDSACPDecoderLayer.forward L99-134
+def forward(self, positions, hidden_states, residual, llama_4_scaling=None):
+    mem = {}
+    mem['start'] = torch.npu.memory_allocated()
+    
+    if not self.input_is_sequence_parallel or ...:
+        hidden_states, residual = super().forward(...)
+    else:
+        hidden_states, residual = self.input_layernorm(hidden_states, residual)
+        mem['pre_attn'] = torch.npu.memory_allocated()
+        torch.npu.reset_peak_memory()
+        
+        hidden_states = self.self_attn.mla_attn.forward_sequence_parallel(
+            positions, hidden_states, output_scale=output_scale)
+        
+        mem['post_attn'] = torch.npu.memory_allocated()
+        mem['attn_peak'] = torch.npu.max_memory_allocated()
+        
+        hidden_states, residual = self.post_attention_layernorm(hidden_states, residual)
+        mem['pre_moe'] = torch.npu.memory_allocated()
+        torch.npu.reset_peak_memory()
+        
+        hidden_states = self.mlp(hidden_states, already_sequence_parallel=True)
+        
+        mem['post_moe'] = torch.npu.memory_allocated()
+        mem['moe_peak'] = torch.npu.max_memory_allocated()
+    
+    if self.gather_sequence_parallel_output:
+        combined = tensor_model_parallel_all_gather(...)
+        ...
+    
+    logger.info(f"[MEM] Layer{self.layer_idx}: "
+                f"attn_peak={mem.get('attn_peak',0)//1024//1024}MB "
+                f"moe_peak={mem.get('moe_peak',0)//1024//1024}MB")
+    return hidden_states, residual
+```
+
+### 5.4 MoE 内部（文件 4）
+
+```python
+# ops/fused_moe/fused_moe.py — AscendMoERunner.forward L161-245
+def forward(self, hidden_states, router_logits, input_ids=None, shared_experts_input=None):
+    mem = {}
+    mem['start'] = torch.npu.memory_allocated()
+    
+    if shared_experts_input is None:
+        hidden_states, shared_experts_input = self.apply_routed_input_transform(hidden_states)
+    
+    hidden_states, _, _ = self._maybe_pad_hidden_states(shared_experts_input, hidden_states)
+    mem['pre_entry'] = torch.npu.memory_allocated()
+    
+    result = self._forward_entry(hidden_states, router_logits, shared_experts_input, ...)
+    
+    mem['post_entry'] = torch.npu.memory_allocated()
+    shared_output, fused_output = _unpack(result)
+    
+    # ... routed/shared reduce ...
+    
+    fused_output = self.apply_routed_output_transform(fused_output)
+    mem['post_xform'] = torch.npu.memory_allocated()
+    
+    # ... combine + reduce ...
+    
+    mem['end'] = torch.npu.memory_allocated()
+    logger.info(f"[MEM] MoE L{self._encode_layer_name()}: "
+                f"entry_delta={(mem['post_entry']-mem['pre_entry'])//1024//1024}MB "
+                f"total_peak={max(mem.values())//1024//1024}MB")
+    return self._maybe_add_zero_expert_output(result)
+```
+
+### 5.5 SFA Attention（文件 5）
+
+```python
+# attention/sfa_v1.py — sparse_mla 函数 L168 附近，或 AscendSFAImpl 的 forward
+def sparse_mla(query, cache, indices, metadata, scale):
+    mem_before = torch.npu.memory_allocated()
+    
+    # ... metadata 构建 ...
+    
+    result = mixed_quant_sparse_flash_mla_fp8(     # 实际的 INT8 sparse MLA 算子
+        query=query.contiguous(),
+        kv_cache=cache,
+        sparse_indices=sorted_indices,
+        ...
+    )
+    
+    mem_after = torch.npu.memory_allocated()
+    logger.info(f"[MEM] SFA: delta={(mem_after-mem_before)//1024//1024}MB")
+    return result[0]
+```
